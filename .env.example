# Telegram bot token dari @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Etherscan V2 API key (1 key untuk semua chain EVM)
# Daftar gratis: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_key

# Solana RPC. Disarankan pakai Helius (gratis): https://helius.dev
# Bisa juga pakai public RPC: https://api.mainnet-beta.solana.com (rate limit ketat)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_key

# Interval polling dalam detik (default 60)
POLL_INTERVAL=60
